# 构建阶段
FROM golang:1.22-alpine AS builder

# 设置工作目录
WORKDIR /app

# 安装基础工具
RUN apk add --no-cache make git

# 复制依赖文件
COPY go.mod go.sum ./
RUN go mod download

# 复制源代码
COPY . .

# 构建视觉服务
RUN mkdir -p build && \
    go build -o build/vision-service -v ./internal/core/vision

# 运行阶段
FROM alpine:latest

# 安装基础依赖
RUN apk add --no-cache ca-certificates tzdata

# 设置时区
ENV TZ=Asia/Shanghai

# 创建非root用户
RUN adduser -D -g '' appuser

# 复制构建产物
COPY --from=builder /app/build/vision-service /usr/local/bin/
COPY --from=builder /app/internal/core/vision/proto /etc/vision/proto

# 创建模型目录
RUN mkdir -p /app/model && chown -R appuser:appuser /app

# 设置工作目录
WORKDIR /usr/local/bin

# 切换到非root用户
USER appuser

# 暴露gRPC端口
EXPOSE 50051

# 设置健康检查
HEALTHCHECK --interval=30s --timeout=3s \
    CMD wget -q --spider http://localhost:50051/health || exit 1

# 启动视觉服务
CMD ["vision-service"] 